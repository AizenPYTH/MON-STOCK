# =============================================================================
# MON STOCK — variables d'environnement
# Copier ce fichier en .env.local (jamais commité) et remplir les valeurs.
# Les variables NEXT_PUBLIC_* sont exposées au navigateur : jamais de secret.
# =============================================================================

# --- Application ---------------------------------------------------------------
# URL publique de l'application (sans slash final). Sert aux callbacks OAuth et aux emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ------------------------------------------------------------------
# Projet Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : SERVEUR UNIQUEMENT (moteur de sync, webhooks, cron, secrets OAuth).
SUPABASE_SERVICE_ROLE_KEY=

# --- Sécurité ------------------------------------------------------------------
# Clé de chiffrement des tokens OAuth et credentials fournisseurs (AES-256-GCM).
# Générer : openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Secret partagé pour les appels /api/cron/* (Vercel Cron ou scheduler externe).
# Générer : openssl rand -hex 32
CRON_SECRET=
# W-18 : routes web /api/cron/* et /api/webhooks/ebay, doublons de l'Edge Function (seule implémentation
# planifiée et enregistrée chez eBay). Désactivées (404) sauf valeur « 1 » (secours, développement local).
MONSTOCK_WEB_LEGACY_ROUTES=

# --- eBay (developer.ebay.com → My Account → Application Keys) ------------------
# "production" ou "sandbox"
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName (« Redirect URL name ») défini dans « User Tokens » → « Get a Token from eBay via Your Application ».
# C'est la valeur attendue par eBay dans le paramètre redirect_uri (ce n'est PAS une URL).
# eBay n'accepte qu'UNE « auth accepted URL » par RuName. EBAY_RU_NAME (aussi lu dans le Vault) est
# celui du relais de l'application iPhone : URL de retour = Edge Function `…/functions/v1/api/ebay/callback`.
EBAY_RU_NAME=
# RuName DÉDIÉ au site web (W-06), URL de retour chez eBay :
#   ${NEXT_PUBLIC_APP_URL}/api/integrations/ebay/callback
# Vide : les boutons « Connecter eBay » du site sont remplacés par « connectez eBay depuis l'app iPhone ».
# Variable du serveur web (Vercel) uniquement, absente du Vault.
EBAY_WEB_RU_NAME=
# Jeton de vérification des notifications eBay (Marketplace Account Deletion / Commerce Notification).
# 32 à 80 caractères alphanumériques, à saisir aussi dans le portail eBay (Alerts & Notifications).
EBAY_WEBHOOK_VERIFICATION_TOKEN=

# --- Sourcing ------------------------------------------------------------------
# User-Agent utilisé par le crawler de sources publiques (identifiez votre application honnêtement).
# Laissez vide pour « MonStockBot/0.1 » ; une valeur contenant example.com est ignorée.
SOURCING_USER_AGENT=
# Contact du robot ajouté au User-Agent « (+contact) » : URL https d'une page « robot » publique ou
# adresse e-mail RÉELLE de l'éditeur. Vide = aucun contact (jamais de contact inventé).
SOURCING_BOT_CONTACT=

# --- Découverte de sources (recherche web officielle) ----------------------------
# Trouve des fournisseurs B2B inconnus via une API de recherche web officielle.
# « none » (défaut) : découverte désactivée (« Découverte désactivée : aucune API de recherche configurée »).
# « brave » : Brave Search API (https://api.search.brave.com) — clé dans BRAVE_SEARCH_API_KEY.
SOURCING_DISCOVERY_PROVIDER=none
# Clé « X-Subscription-Token » de la Brave Search API (SERVEUR UNIQUEMENT).
BRAVE_SEARCH_API_KEY=
