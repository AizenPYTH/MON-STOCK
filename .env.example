# =============================================================================
# MON STOCK — variables d'environnement (site web Next.js, scripts, tests)
# Copier en .env.local (jamais commité) et remplir. Valeurs ci-dessous : factices ou vides.
# NEXT_PUBLIC_* est exposé au navigateur : jamais de secret.
# Une ligne commentée (« # NOM= ») est facultative : la décommenter seulement pour changer le défaut
# (une valeur vide n'est pas toujours équivalente à une variable absente).
# Production : secrets dans Vercel, l'Edge Function et le Vault, jamais ici (docs/OPERATIONS.md § 10).
# Variables de l'application mobile : apps/mobile/.env.example.
# =============================================================================

# --- Application ---------------------------------------------------------------
# URL canonique du site, sans slash final (retours OAuth, e-mails, robots.txt) ; production : https://mon-stock-chi.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ------------------------------------------------------------------
# URL du projet (Project Settings → API) : un projet de développement ou de préproduction, jamais la production.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique (sb_publishable_… ou ancienne clé « anon ») : protégée par la RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète service_role : SERVEUR UNIQUEMENT (synchro, webhooks, cron, secrets OAuth, lecture du Vault).
SUPABASE_SERVICE_ROLE_KEY=
# Facultatif : URL Supabase côté serveur si elle diffère de NEXT_PUBLIC_SUPABASE_URL (lecture du Vault au démarrage).
# SUPABASE_URL=

# --- Chiffrement et tâches planifiées -------------------------------------------
# Clé AES-256-GCM des jetons OAuth et identifiants fournisseurs : 32 octets en base64 (openssl rand -base64 32).
TOKEN_ENCRYPTION_KEY=
# Rotation (docs/SERVER.md « Rotation de la clé de chiffrement ») : version de la clé courante (défaut 1).
# TOKEN_ENCRYPTION_KEY_VERSION=
# Rotation : anciennes clés encore utilisées pour déchiffrer, « <version>:<clé base64> » séparées par des virgules.
# TOKEN_ENCRYPTION_KEY_PREVIOUS=
# Compatibilité seulement : « passphrase-sha256 » pour une ancienne clé qui n'est pas du base64 de 32 octets.
# TOKEN_ENCRYPTION_KEY_FORMAT=
# Secret des routes /api/cron/* (Authorization: Bearer …), au moins 16 caractères (openssl rand -hex 32).
CRON_SECRET=
# W-18 : « 1 » réactive les routes web /api/cron/* et /api/webhooks/ebay (désactivées, 404, par défaut).
MONSTOCK_WEB_LEGACY_ROUTES=
# Facultatif : budget d'un run de synchronisation en ms (défaut 100000, borné de 5000 à 480000).
# SYNC_RUN_BUDGET_MS=

# --- eBay (developer.ebay.com → My Account → Application Keys) ------------------
# Environnement du keyset : « production » ou « sandbox » (sandbox en développement).
EBAY_ENV=production
# App ID (Client ID) du keyset.
EBAY_CLIENT_ID=
# Cert ID (Client Secret) du keyset : secret serveur.
EBAY_CLIENT_SECRET=
# RuName du relais iPhone (retour : Edge Function …/functions/v1/api/ebay/callback) ; ce n'est pas une URL.
EBAY_RU_NAME=
# RuName dédié au site (retour : ${NEXT_PUBLIC_APP_URL}/api/integrations/ebay/callback) ; vide = connexion eBay web désactivée.
EBAY_WEB_RU_NAME=
# Jeton de vérification des notifications eBay : 32 à 80 caractères alphanumériques (openssl rand -hex 24).
EBAY_WEBHOOK_VERIFICATION_TOKEN=
# Facultatif : « true » autorise la publication réelle d'annonces (désactivée par défaut, verrous en plus).
# EBAY_LISTING_ENABLED=
# Facultatif : budget quotidien d'appels eBay de l'application (défaut 5000), alerte à 80 %.
# EBAY_DAILY_CALL_BUDGET=

# --- Sourcing ------------------------------------------------------------------
# User-Agent du robot de collecte ; vide = « MonStockBot/0.1 » (une valeur contenant example.com est ignorée).
SOURCING_USER_AGENT=
# Contact réel du robot (URL https d'une page « robot » ou e-mail de l'éditeur) ; vide = aucun contact inventé.
SOURCING_BOT_CONTACT=
# Découverte de fournisseurs par API de recherche web : « none » (défaut) ou « brave ».
SOURCING_DISCOVERY_PROVIDER=none
# Clé « X-Subscription-Token » de la Brave Search API (serveur uniquement, si SOURCING_DISCOVERY_PROVIDER=brave).
BRAVE_SEARCH_API_KEY=

# --- Services tiers lus par l'Edge Function --------------------------------------
# En production, ces secrets vivent dans Supabase → Edge Functions → Secrets (le site passe par l'Edge).
# Ici, seulement pour exercer ces services en local (scripts, tests manuels).
# Clé de l'API OpenAI (conseiller, produit dicté, voix) ; absente = IA « non activée ».
# OPENAI_API_KEY=
# Modèle de texte OpenAI (défaut gpt-5.4-mini).
# OPENAI_MODEL=
# Modèle de synthèse vocale OpenAI (défaut du code ; aussi lu par scripts/tts-compare.mjs).
# OPENAI_TTS_MODEL=
# Voix du conseiller par défaut (marin ou cedar).
# OPENAI_TTS_VOICE=
# Durée du cache HTTP de l'audio en secondes (0 à 604800, défaut 86400 ; 0 = aucun cache).
# ADVISOR_AUDIO_MAX_AGE_SECONDS=
# Devis d'expédition Packlink PRO (Paramètres → clé API).
# PACKLINK_API_KEY=
# Devis Sendcloud (consultation seulement) : clé publique de l'API.
# SENDCLOUD_PUBLIC_KEY=
# Devis Sendcloud : clé secrète de l'API.
# SENDCLOUD_SECRET_KEY=
# Cotation Boxtal : identifiant de l'API v1.
# BOXTAL_V1_LOGIN=
# Cotation Boxtal : mot de passe de l'API v1.
# BOXTAL_V1_PASSWORD=
# Cotation Boxtal : code de catégorie de contenu fourni par Boxtal.
# BOXTAL_CONTENT_CODE=
# Cotation Boxtal : URL de l'API si elle diffère du défaut du code.
# BOXTAL_API_URL=
# Suivi La Poste / Colissimo / Chronopost (developer.laposte.fr, API « Suivi v2 »).
# LAPOSTE_OKAPI_KEY=
# Suivi multi-transporteurs Ship24.
# SHIP24_API_KEY=
# Suivi DHL (developer.dhl.com, « Shipment Tracking - Unified »).
# DHL_API_KEY=
# Prototype Karrio, non branché à l'application : URL https du serveur Karrio.
# KARRIO_API_URL=
# Prototype Karrio, non branché : clé d'API.
# KARRIO_API_KEY=
# CORS de l'Edge : origine du site si elle diffère de NEXT_PUBLIC_APP_URL.
# APP_URL=
# CORS de l'Edge : origines https supplémentaires, séparées par des virgules.
# EDGE_CORS_ORIGINS=
# CORS de l'Edge : « 1 » autorise http://localhost:* (développement seulement).
# EDGE_CORS_ALLOW_LOCALHOST=

# --- Scripts et garde-fous -------------------------------------------------------
# Base visée par les tests d'intégration, db:types et sourcing:test-searches (base locale jetable par défaut).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mon_stock_test
# Dérogation volontaire au refus de la production : référence EXACTE du projet visé (jamais « 1 » ni « true »).
# MONSTOCK_ALLOW_PRODUCTION=
# Références de projets de production supplémentaires à refuser, séparées par des virgules.
# MONSTOCK_PRODUCTION_REFS=
# db:local:reset : dérogation pour un serveur PostgreSQL distant jetable (valeur = PGHOST exact ; jamais Supabase).
# MONSTOCK_ALLOW_REMOTE_DB_RESET=
# db:local:reset lit aussi les variables libpq : PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE (défaut mon_stock_test).
# Aperçu visuel sans base (« 1 », avec NEXT_PUBLIC_SUPABASE_URL=https://preview.invalid) : jamais en production.
# MONSTOCK_WEB_PREVIEW=

# --- Tests ------------------------------------------------------------------------
# « 1 » : une base d'intégration injoignable fait échouer les tests au lieu de les ignorer (réglage de la CI).
# REQUIRE_DB=1
# Adresse du serveur visé par Playwright (défaut http://localhost:3100).
# E2E_BASE_URL=http://localhost:3100
# Dossier des captures et traces e2e, hors du dépôt (défaut : dossier temporaire).
# E2E_OUTPUT_DIR=
# Chromium à utiliser par Playwright (défaut : celui de Playwright).
# PLAYWRIGHT_CHROMIUM_PATH=
# « 1 » active le parcours d'inscription e2e (crée un compte : préproduction uniquement).
# E2E_ONBOARDING=
# Domaine des adresses de test du parcours d'inscription (défaut exemple.test).
# E2E_SIGNUP_EMAIL_DOMAIN=

# --- Fournies par la plateforme : ne pas définir ----------------------------------
# NODE_ENV, NEXT_RUNTIME (Next.js) ; VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL (Vercel, repli de NEXT_PUBLIC_APP_URL) ;
# SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_URL (fournies automatiquement à l'Edge Function).
