{
  "expo": {
    "name": "Mon Stock Pro",
    "slug": "mon-stock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.aizenpyth.monstock",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Mon Stock Pro n'accède pas à votre photothèque et ne vous demandera pas cette autorisation. Cette mention est requise par Apple car un composant d'Expo inclus dans l'application contient du code de lecture de photos, jamais utilisé."
      }
    },
    "android": {
      "package": "com.aizenpyth.monstock",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-web-browser",
      "expo-splash-screen",
      "expo-asset",
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Mon Stock Pro utilise le micro pour dicter un produit à ajouter ou une question à l'assistant.",
          "speechRecognitionPermission": "Mon Stock Pro transcrit votre voix (reconnaissance vocale d'Apple) pour remplir un produit ou poser une question à l'assistant."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e29be57c-14cf-40eb-891d-c3f97350c013"
      }
    },
    "scheme": "monstock",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "experiments": {
      "typedRoutes": false
    },
    "owner": "influence1"
  }
}
