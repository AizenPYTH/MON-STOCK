# =============================================================================
# MON STOCK — application mobile (Expo). Copier en .env.local (jamais commité).
# Les variables EXPO_PUBLIC_* sont INCLUSES DANS L'APPLICATION : jamais de secret ici.
# (pas de clé service_role, pas de token eBay, pas de clé privée)
# =============================================================================

# Projet Supabase de l'environnement visé (TEST pour la bêta) → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique (sb_publishable_… ; à défaut l'ancienne clé « anon ») : protégée par la RLS,
# conçue pour être embarquée dans l'application. JAMAIS la clé secrète / service_role.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nom affiché de l'environnement (TEST, PROD…) dans Réglages.
EXPO_PUBLIC_APP_ENV=TEST

# Le serveur MON STOCK est l'Edge Function `api` du MÊME projet Supabase
# (${EXPO_PUBLIC_SUPABASE_URL}/functions/v1/api) : aucune autre URL d'API n'est lue.

# Site web public (Confidentialité, Conditions, Support, Mentions légales ouverts depuis l'app).
# Facultatif : défaut https://mon-stock-chi.vercel.app. https obligatoire.
EXPO_PUBLIC_SITE_URL=
