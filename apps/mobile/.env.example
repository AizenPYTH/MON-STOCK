# =============================================================================
# MON STOCK — application mobile (Expo). Copier en .env.local (jamais commité).
# Les variables EXPO_PUBLIC_* sont INCLUSES DANS L'APPLICATION : jamais de secret ici
# (pas de clé service_role / sb_secret_, pas de jeton eBay, pas de clé privée ; `npm run scan:bundle` le vérifie).
# Builds EAS : ces valeurs viennent des profils de apps/mobile/eas.json, pas de ce fichier.
# =============================================================================

# URL du projet Supabase visé (Project Settings → API), en https ; l'Edge Function `api` est lue sur ce même projet.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique sb_publishable_… (protégée par la RLS, faite pour être embarquée) ; JAMAIS la clé secrète.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Ancien nom de la clé publique (« anon »), lu seulement si EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY est vide.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Nom de l'environnement affiché dans Réglages (TEST, PREPROD, PROD…) ; défaut TEST.
EXPO_PUBLIC_APP_ENV=TEST
# Site web public (confidentialité, conditions, support) en https ; vide = https://mon-stock-chi.vercel.app.
EXPO_PUBLIC_SITE_URL=

# Aucune autre URL d'API n'est lue : le serveur est ${EXPO_PUBLIC_SUPABASE_URL}/functions/v1/api.

# --- Aperçu visuel (ligne de commande, jamais dans une build) -----------------------
# « 1 » remplace Supabase et l'API par une base de démonstration en mémoire (metro.config.js).
# MONSTOCK_PREVIEW=
# Dossier node_modules contenant react-native-web pour l'aperçu.
# MONSTOCK_PREVIEW_MODULES=
# Capture d'écran de l'aperçu (preview/capture.mjs) : chemin du module playwright.
# PLAYWRIGHT_MODULE=
# Capture : chemin de Chromium.
# CHROMIUM_PATH=
# Capture : largeur de la fenêtre en pixels (défaut 390).
# CAPTURE_WIDTH=
