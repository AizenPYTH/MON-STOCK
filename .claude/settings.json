  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Supabase__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/supabase-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Garde-fou Supabase (projet TEST, SQL en lecture seule)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Garde-fou des commandes (déploiements, secrets, push)"
          }
        ]
      }
    ]
  }
