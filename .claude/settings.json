{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__Supabase__list_projects",
      "mcp__Supabase__get_project",
      "mcp__Supabase__get_project_url",
      "mcp__Supabase__get_publishable_keys",
      "mcp__Supabase__list_tables",
      "mcp__Supabase__list_extensions",
      "mcp__Supabase__list_migrations",
      "mcp__Supabase__list_edge_functions",
      "mcp__Supabase__get_edge_function",
      "mcp__Supabase__get_advisors",
      "mcp__Supabase__get_logs",
      "mcp__Supabase__query_logs",
      "mcp__Supabase__search_docs",
      "mcp__Supabase__generate_typescript_types",
      "mcp__Supabase__execute_sql",
      "mcp__Supabase__apply_migration",
      "mcp__Supabase__deploy_edge_function",

      "mcp__Expo__build_info",
      "mcp__Expo__build_list",
      "mcp__Expo__build_logs",
      "mcp__Expo__search_documentation",
      "mcp__Expo__read_documentation",
      "mcp__Expo__testflight_feedback",
      "mcp__Expo__testflight_crashes",

      "mcp__github__get_file_contents",
      "mcp__github__list_commits",
      "mcp__github__list_branches",
      "mcp__github__search_repositories",
      "mcp__github__get_commit",

      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(npx vitest *)",
      "Bash(npx jest *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx expo export *)",
      "Bash(node scripts/*)",
      "Bash(node .claude/hooks/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git rev-parse *)",
      "Bash(git push -u origin claude/laughing-bardeen-bdn16j)",
      "Bash(git push origin claude/laughing-bardeen-bdn16j)",
      "Bash(git push -q origin claude/laughing-bardeen-bdn16j)",
      "Bash(pg_lsclusters)",
      "Bash(pg_ctlcluster 16 main start)",
      "Bash(psql *)"
    ],
    "ask": [
      "mcp__Supabase__create_project",
      "mcp__Supabase__pause_project",
      "mcp__Supabase__restore_project",
      "mcp__Supabase__create_branch",
      "mcp__Supabase__delete_branch",
      "mcp__Supabase__merge_branch",
      "mcp__Supabase__reset_branch",
      "mcp__Supabase__rebase_branch",
      "mcp__Expo__build_run",
      "mcp__Expo__build_submit",
      "mcp__Expo__build_cancel",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Supabase__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/supabase-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Garde-fou Supabase (projet TEST, SQL destructeur)"
          }
        ]
      }
    ]
  }
}
